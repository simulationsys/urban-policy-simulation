# Repo-root build context (see backend/Dockerfile).
# NOTE: data/processed_data is deliberately NOT ignored — the mesa engine needs the road
# graph and population parquet inside the image to simulate real streets.

.git/
.github/
.claude/

# Python build artifacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend (built and deployed separately)
node_modules/
frontend/.next/
frontend/node_modules/

# Local state and secrets
.env
**/.env.local
**/*.sqlite

# Bulky inputs that the image does not need: raw OSM downloads and the osmnx cache.
data/raw_data/
data/cache/
data/pipelines/cache/
simulation/data/cache/
research/
docs/

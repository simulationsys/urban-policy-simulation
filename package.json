{
  "name": "urban-policy-simulation",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend/landing-page"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend/landing-page",
    "dev:frontend": "npm run dev --prefix frontend/landing-page",
    "build:frontend": "npm run build --prefix frontend/landing-page",
    "start:frontend": "npm run start --prefix frontend/landing-page",
    "install:all": "npm install --prefix frontend/landing-page",
    "dev:backend": "cd backend && uvicorn app.main:app --reload",
    "test:backend": "cd backend && pytest"
  }
}
